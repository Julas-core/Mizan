# Copy this file to .env and fill in your values
# Never commit .env to version control!

# Environment (development / staging / production)
ENVIRONMENT=development

# PostgreSQL Connection String (REQUIRED)
# For Docker Compose, this is overridden by the compose file
DATABASE_URL=postgresql://mizan:mizan_secret@localhost:5432/mizan_db

# Gemini API Key — get yours at https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret Key (REQUIRED — generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000

